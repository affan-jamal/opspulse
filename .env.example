# OpsPulse environment. Copy to .env (git-ignored) and replace every change-me.
# docker compose reads .env automatically. Containers get DATABASE_URL and REDIS_URL
# rewritten to the in-network hosts (postgres, redis) by compose.yaml.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Phase 1: ETL ---------------------------------------------------------------
# Nothing required. OPSPULSE_ROOT overrides where data/ and reports/ live.
# OPSPULSE_ROOT=

# --- Phase 2: PostgreSQL -----------------------------------------------------------
POSTGRES_DB=opspulse
POSTGRES_USER=opspulse
POSTGRES_PASSWORD=change-me
# Host port; change it if something else on your machine already uses 5432.
POSTGRES_PORT=5432
# Used by `uv run ...` on your machine.
DATABASE_URL=postgresql+psycopg://opspulse:change-me@localhost:5432/opspulse

# --- Phase 3: Provider API (the simulated third party) ------------------------------
PROVIDER_API_KEY=change-me
PROVIDER_BASE_URL=http://localhost:8001
PROVIDER_RATE_LIMIT_PER_MINUTE=120
# Share of requests answered with an injected 429/500/503/timeout. 0 disables faults.
PROVIDER_FAULT_RATE=0.05
# Simulated time the replay clock starts from (inside the analysis window).
REPLAY_START_DATE=2017-01-01

# --- Phase 4: Ingestion and sync ------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
SYNC_INTERVAL_SECONDS=30
REPLAY_DAYS_PER_TICK=1

# --- Phase 5: Analytics API -----------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
API_CORS_ORIGINS=http://localhost:3000

# --- Phase 8: Deployment and monitoring (leave empty locally) -------------------------
# Image compose runs instead of building locally, e.g. ghcr.io/affan-jamal/opspulse:latest
OPSPULSE_IMAGE=
# Public hostname Caddy requests a TLS certificate for, e.g. opspulse.duckdns.org
DOMAIN=
ACME_EMAIL=
SENTRY_DSN=
